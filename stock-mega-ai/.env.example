# ---- Server-side only. NEVER commit real values. NEVER expose to the browser. ----

# Finnhub (free tier): https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here

# Supabase project settings -> API
# Use the SERVICE ROLE key (server-side only). Do not use the anon key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: protect the cron endpoint. If set, /api/cron-close requires
# the header "x-cron-secret" to match (Vercel cron can send it via config).
CRON_SECRET=
